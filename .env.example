# FODEARS: copiar a .env.local y completar. Vite solo expone variables con prefijo VITE_.
# Todo lo que empieza con VITE_ termina en el bundle del navegador: NO poner secretos acá.

# Fuente de cotizaciones: mock | data912
#   mock    → datos de ejemplo, sin red (por defecto en pnpm dev)
#   data912 → https://data912.com (gratis, sin key, demorado; por defecto en el build de producción)
# En el deploy de producción de Vercel, cualquier valor que no sea data912 hace fallar el build.
VITE_DATA_PROVIDER=mock

# Firebase (Console → Configuración del proyecto → Tus apps → App web).
# Si falta alguna, el login funciona en modo demo y los datos se guardan en localStorage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
