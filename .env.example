# Copiar a .env y completar. El archivo .env nunca se sube al repo.

# Credenciales de InvertirOnline (las mismas del sitio web, con la API habilitada en la cuenta)
IOL_USER=
IOL_PASS=

# URL base de la API de IOL
IOL_BASE_URL=https://api.invertironline.com

# Backend: solo localhost
HOST=127.0.0.1
PORT=3001
