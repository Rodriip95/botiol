{
  "name": "bot-iol",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @bot-iol/server --filter @bot-iol/web dev",
    "dev:server": "pnpm --filter @bot-iol/server dev",
    "dev:web": "pnpm --filter @bot-iol/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "quote": "pnpm --filter @bot-iol/server quote"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
